# 核心硬件架构与小米 AX3000 v1 型号选择
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_xiaomi_ax3000=y

# 核心 NSS 硬件加速驱动与 ECM 分流器
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_qca-nss-napi=y

# 无线固件与底层微码包
CONFIG_PACKAGE_ath11k-firmware-ipq50xx=y

# 核心科学加速插件 HomeProxy 及其依赖
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_homeproxy=y
CONFIG_PACKAGE_sing-box=y

# 推荐添加的轻量内存优化 ZRAM（256M 物理内存守护神器）
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# 基础必备组件与中文语言包
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y
