# 1. 硬件锁定
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_xiaomi_ax3000=y
CONFIG_HAS_SUBTARGETS=y
CONFIG_HAS_TARGET_DEVICES=y
CONFIG_TARGET_BOARD="qualcommax"
CONFIG_TARGET_SUBTARGET="ipq50xx"
CONFIG_TARGET_PROFILE="DEVICE_xiaomi_ax3000"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_DEFAULT_TARGET_qualcommax_ipq50xx_DEVICE_xiaomi_ax3000=y

# 2. 核心网络引擎 (仅留必要的 NSS 与无线)
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_qca-nss-napi=y
CONFIG_PACKAGE_ath11k-firmware-ipq50xx=y

# 3. 守护核心：HomeProxy 与 Sing-box 运行库
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_homeproxy=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_libsetlbf=y

# 4. 网页后台与中文包
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y

# 5. 内存续命神器 (开辟 ZRAM 压缩虚拟内存，256M 物理直接扩容到约 350M 体验)
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# ==================== 6. 极限剔除无用组件 (核心瘦身区) ====================
# 强行关闭一切无用多媒体和文件共享支持
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb-dwc3=n
CONFIG_PACKAGE_kmod-usb3=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-sound-core=n
CONFIG_PACKAGE_automount=n

# 强行关闭由于 Linux 6.12 引入的庞大网络日志与诊断协议 (不影响日常使用)
CONFIG_PACKAGE_kmod-bluetooth=n
CONFIG_PACKAGE_kmod-nft-bridge=n
CONFIG_PACKAGE_etherwake=n
CONFIG_PACKAGE_iputils-arping=n

# 强行关闭全量加密库，仅保留 HomeProxy 必须的加密协议
CONFIG_PACKAGE_libopenssl-legacy=n
CONFIG_PACKAGE_wpad=n
# 改用轻量级的 wpad-mesh-mbedtls 或 wpad-basic-mbedtls，省下近 8MB 运行内存
CONFIG_PACKAGE_wpad-basic-mbedtls=y
